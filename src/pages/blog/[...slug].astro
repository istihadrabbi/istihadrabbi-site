---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import DownloadResume from '../../components/DownloadResume.astro';
import Comments from '../../components/Comments.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const hasImg = post.data.image && fs.existsSync(`public${post.data.image}`);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title={`${post.data.title} | Istihad Rabbi`} description={post.data.description} image={hasImg ? post.data.image : undefined} type="article">
  <article class="section">
    <div class="container">
      <header class="head">
        <a href="/blog/" class="small">← All articles</a>
        <h1>{post.data.title}</h1>
        <p class="muted">{fmt(post.data.date)}{post.data.tags.length > 0 && ` · ${post.data.tags.join(', ')}`}</p>
        {hasImg && <img class="cover" src={post.data.image} alt="" />}
      </header>
      <div class="prose"><Content /></div>
      <aside class="prose author card">
        <div>
          <strong>Istihad Rabbi</strong>
          <p class="muted">Digital Marketing Analyst in Los Angeles. Paid media, SEO and analytics.</p>
        </div>
        <DownloadResume variant="ghost" />
      </aside>
      <div class="prose"><Comments term={post.id} /></div>
    </div>
  </article>
</Base>
<style>
  .head { max-width: 820px; margin: 0 auto 36px; text-align: center; }
  .head h1 { font-size: clamp(2rem, 4.4vw, 3rem); margin-top: 1rem; }
  .cover { border-radius: 16px; margin-top: 28px; width: 100%; }
  .small { font-size: .9rem; }
  .author { margin-top: 56px !important; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .author p { margin: 0; }
</style>
