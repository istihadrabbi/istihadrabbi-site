---
// "Download Resume" call-to-action: lets the visitor choose PDF or Word.
import { resumeFiles } from '../data/resume';
interface Props { variant?: 'primary' | 'ghost'; label?: string; align?: 'left' | 'right'; }
const { variant = 'primary', label = 'Download Resume', align = 'left' } = Astro.props;
---
<div class={`dl ${align}`} data-dl>
  <button type="button" class={`btn btn-${variant}`} aria-haspopup="true" aria-expanded="false" data-dl-toggle>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
    {label}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  <div class="dl-menu" role="menu" hidden data-dl-menu>
    <a role="menuitem" href={resumeFiles.pdf} download data-format="pdf">
      <span class="badge pdf">PDF</span>
      <span><strong>PDF</strong><small>Best for reading and printing</small></span>
    </a>
    <a role="menuitem" href={resumeFiles.docx} download data-format="docx">
      <span class="badge doc">DOC</span>
      <span><strong>Word (.docx)</strong><small>Best for job portals and recruiters</small></span>
    </a>
    <p class="note">Both versions are ATS-friendly.</p>
  </div>
</div>

<style>
  .dl { position: relative; display: inline-block; }
  .dl-menu {
    position: absolute; top: calc(100% + 10px); left: 0; z-index: 60; width: 290px;
    background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 8px;
    box-shadow: 0 20px 40px rgba(15, 23, 42, .16);
  }
  .dl.right .dl-menu { left: auto; right: 0; }
  .dl-menu a {
    display: flex; gap: 12px; align-items: center; padding: 10px; border-radius: 10px; color: var(--ink);
    text-decoration: none;
  }
  .dl-menu a:hover, .dl-menu a:focus-visible { background: var(--bg-soft); }
  .dl-menu strong { display: block; font-size: .95rem; }
  .dl-menu small { display: block; color: var(--muted); font-size: .8rem; }
  .badge { flex: none; width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; font-size: .72rem; font-weight: 800; color: #fff; }
  .badge.pdf { background: #dc2626; }
  .badge.doc { background: #2563eb; }
  .note { margin: 4px 10px 6px; font-size: .78rem; color: var(--good); font-weight: 600; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-dl]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-dl-toggle]')!;
    const menu = root.querySelector<HTMLElement>('[data-dl-menu]')!;
    const set = (open: boolean) => { menu.hidden = !open; btn.setAttribute('aria-expanded', String(open)); };
    btn.addEventListener('click', (e) => { e.stopPropagation(); set(menu.hidden); });
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    menu.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => a.addEventListener('click', () => {
      // Analytics hook: works with GA4 if it is added later.
      (window as any).gtag?.('event', 'resume_download', { format: a.dataset.format });
      set(false);
    }));
  });
</script>
